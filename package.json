{
  "name": "google-search-console-mcp",
  "version": "3.0.0",
  "private": true,
  "description": "Connect Google Search Console reporting data to ChatGPT through MCP.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create gsc-chatgpt-mcp",
    "db:migrate:local": "wrangler d1 migrations apply gsc-chatgpt-mcp --local",
    "db:migrate:remote": "wrangler d1 migrations apply gsc-chatgpt-mcp --remote",
    "types": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": { "wrangler": "^4.0.0" }
}
